{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "Path": "data.db"
  },
  "Backup": {
    "Enabled": false,
    "Interval": "01:00:00",
    "Directory": "backups",
    "LocalRetentionDays": 7,
    "MaxLocalBytes": 10737418240,
    "MinFreeDiskBytes": 536870912,
    "Timeout": "00:05:00",
    "PagesPerStep": 128,
    "StepDelay": "00:00:00.010",
    "FullCheckInterval": "1.00:00:00",
    "UploadTimeout": "00:05:00",
    "UploadRetryInterval": "00:01:00",
    "MaxUploadRetryInterval": "00:30:00",
    "Oss": {
      "Enabled": false,
      "Region": "cn-hangzhou",
      "Endpoint": "",
      "Bucket": "replace-with-backup-bucket",
      "Prefix": "survey-backend/production",
      "AccessKeyId": "",
      "AccessKeySecret": "",
      "SecurityToken": ""
    }
  },
  "Bot": {
    "accessToken": "replace-with-onebot-access-token",
    "wsPort": 21568,
    "mainGroupId": 123456789,
    "verifyGroupId": 123456789,
    "adminId": 123456789
  },
  "Review": {
    "MinimumVotes": 4,
    "AgreeRateThreshold": 0.6
  },
  "API": {
    "Endpoint": "https://api.example.com/",
    "SurveyLinkEndpoint": "https://survey.example.com/"
  },
  "LLM": {
    "ModelName": "gpt-6-luna",
    "OpenAIKey": "replace-with-openai-api-key",
    "OpenAIEndpoint": "https://api.openai.com/v1",
    "SysPromptPath": "sysPrompt.txt",
    "ReasoningEffort": "medium",
    "UseWebSearch": false
  },
  "IsDisabled": false
}
